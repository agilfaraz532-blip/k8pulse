# Copy to k8s/secrets.env (gitignored) and fill in real values before deploying:
#   cp k8s/secrets.env.example k8s/secrets.env
# kustomize turns this file into the k8spulse-secrets Secret.
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
# Must use the same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@k8spulse-postgres:5432/k8spulse_db
GEMINI_API_KEY=
GRAFANA_ADMIN_PASSWORD=replace-me
