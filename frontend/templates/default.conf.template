# Rendered at container start by the nginx image (envsubst):
#   BACKEND_UPSTREAM  - backend address, e.g. backend:8000 (compose) or k8spulse-backend:8000 (Kubernetes)
#   DNS_RESOLVER      - DNS server nginx uses to re-resolve the backend (Docker: 127.0.0.11)
server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Re-resolve periodically so a recreated backend (new IP) doesn't cause 502s
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # Proxy API requests to backend
    location /api/ {
        set $backend_upstream http://${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Local LLM (Ollama) analysis can take minutes on CPU-only machines
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
    }

    # Interactive API docs (Swagger UI) served by the backend
    location ~ ^/(docs|redoc|openapi\.json)$ {
        set $backend_upstream http://${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }
}
