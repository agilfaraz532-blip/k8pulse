# ==============================================================================
# K8sPulse - Kubernetes Monitoring Dashboard Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kubernetes Cluster Configuration
# Empty string means in-cluster config or default ~/.kube/config
KUBECONFIG_PATH=
K8S_IN_CLUSTER=false
K8S_REQUEST_TIMEOUT=10

# Prometheus Monitoring
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=5

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/k8spulse_db
DB_ECHO=false

# Google Gemini AI Integration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama LLM (tried first; Gemini is the fallback)
# Use http://host.docker.internal:11434 when the backend runs in Docker
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=512

# Alert Thresholds Default
ALERT_CPU_THRESHOLD_PERCENT=80
ALERT_MEMORY_THRESHOLD_PERCENT=80
ALERT_POD_RESTART_THRESHOLD=5
